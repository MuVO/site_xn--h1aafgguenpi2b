---
import YandexMetrika from '../components/YandexMetrika.astro';
const destination = '/main/';
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <title>Реквизиты</title>
    <YandexMetrika />
  </head>
  <body>
    <p>Переход к визитке: <a href={destination}>Основное</a></p>
    <script>window.location.replace('/main/');</script>
  </body>
</html>
