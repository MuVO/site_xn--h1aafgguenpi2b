---
const { label, value, className = 'value' } = Astro.props;
---
<button
  type="button"
  class={`copy ${className}`}
  data-copy={value}
  data-copy-label={label}
  aria-label={`Скопировать: ${label}`}
>
  <span>{value}</span>
  <svg class="copy-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <rect x="6.5" y="3.5" width="10" height="12" rx="2" />
    <path d="M13.5 16.5v.25a1.75 1.75 0 0 1-1.75 1.75h-7A1.75 1.75 0 0 1 3 16.75v-9A1.75 1.75 0 0 1 4.75 6h.5" />
  </svg>
</button>
